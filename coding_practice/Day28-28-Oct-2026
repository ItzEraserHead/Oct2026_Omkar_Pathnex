## RollBack Strategy

pipeline {
    agent any
    environment {
        INSTITUTE_NAME = "Pathnex"
        TEAM = "DevOps"
        ENV = "prod"
    }
    stages {
        stage('Deploy') {
            steps {
                script {
                    try {
                        sh 'echo "Deploying $INSTITUTE_NAME app in $ENV for $TEAM team"'
                        sh 'exit 1' // simulate failure
                    }
                    catch (Exception e) {
                        echo "Deployment failed, Rolling back $INSTITUTE_NAME app in $ENV"
                        throw e
                    }
                }
            }
        }
    }
}

