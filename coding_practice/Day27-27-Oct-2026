## Jenkins

node {
    def envName = "dev"
    env.INSTITUTE_NAME = "Pathnex"
    env.TEAM = "DevOps"

    stage('Checkout') {
      git url: 'https://github.com/Pathnex/sample-java-app.git'
    }
    satge('Build') {
      if (envName == 'dev') {
        sh 'echo "Building $INSTITUTE_NAME app in a dev environment for $TEAM"'
      }
      else {
        sh 'echo "Skipping build for $envName"'
      }
    }
    stage('Deploy') {
      input message: "Approve deployment for $envName?"
      sh 'echo "Deploting $INSTITUTE_NAME app to $envName for $TEAM team"'
    }
}