## Day 27 - Copy Dir, EBS Volume, NodePort, Log Cleaner

## Ansible

---
- name: Copy Pathnex files
  hosts: all
  become: true

  tasks:
    - name: Copy Directory
      copy:
        src: /opt/pathnex/
        dest: /backup/pathnex/
        remote_src: yes

##  Terraform

resource "aws_ebs_volume" "PathnexVolume" {
    availability_zone = "ap-south-1"
    size = 20

    tags = {
        Name = "Pathnex-Volume"
    }
}

resource "aws_volume_attachment" "PathnexAttach" {
    device name = "/dev/sdh"
    volume_id = aws_abs_volume.PathnexVolume.id
    instance_id = aws_instance.PathnexEC2.id
}

## Kubernetes

apiVersion: v1
kind: Service
metadata:
  name: pathnex-nodeport
spec:
  type: NodePort
  selector:
    app: pathnex
  ports:
    - port: 80
      targetPort: 80
      nodePort: 30079


## Shell Script

#!/bin/bash

find /var/log -type f -mtime +7 -exec rm -f {} \;

echo "old logs removed"

